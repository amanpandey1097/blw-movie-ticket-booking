# Server
PORT=5000
FRONTEND_URLS=http://localhost:5173
SHOW_TIMEZONE_OFFSET=+05:30

# MongoDB Atlas
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/blw_cinema?retryWrites=true&w=majority

# Redis / Upstash Redis
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
SEAT_LOCK_TTL_SECONDS=600

# Authentication
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
AUTH_TEST_MODE=true
ADMIN_INVITE_CODE=replace_with_a_private_admin_signup_code

# Optional real OTP delivery. Not needed while AUTH_TEST_MODE=true.
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Razorpay TEST MODE keys only for this build
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Cloudinary poster uploads
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
